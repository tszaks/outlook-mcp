{
  "name": "outlook-mcp",
  "version": "1.2.0",
  "description": "Microsoft Outlook MCP server with built-in OAuth onboarding for mail, calendar, and contacts",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "outlook-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "postinstall": "bash scripts/build-ocr.sh"
  },
  "keywords": [
    "mcp",
    "outlook",
    "microsoft-graph",
    "oauth",
    "model-context-protocol"
  ],
  "author": "Tyler Szakacs",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "mammoth": "^1.9.0",
    "officeparser": "^5.0.0",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
